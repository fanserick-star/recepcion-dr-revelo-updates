{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dr-revelo-whatsapp-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "GRAPH_VERSION": "v26.0",
    "TEMPLATE_RECORDATORIO_CITA": "recordatorio_cita",
    "LANG_RECORDATORIO_CITA": "es_ES",
    "ENABLE_RECORDATORIO_CITA": "1",
    "TEMPLATE_CITA_AGENDADA": "cita_agendada",
    "LANG_CITA_AGENDADA": "es_EC",
    "ENABLE_CITA_AGENDADA": "0",
    "TEMPLATE_RECORDATORIO_HOY": "recordatorio_hoy",
    "LANG_RECORDATORIO_HOY": "es_EC",
    "ENABLE_RECORDATORIO_HOY": "0",
    "PREVIOUS_DAY_TIME": "08:00",
    "TODAY_HOURS_BEFORE": "2",
    "TIME_ZONE": "America/Guayaquil"
  }
}
