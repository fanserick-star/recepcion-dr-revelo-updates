{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dr-revelo-whatsapp-cloud",
  "main": "./whatsapp_worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}
