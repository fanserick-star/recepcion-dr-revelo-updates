{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dr-revelo-whatsapp-cloud",
  "main": "./whatsapp_worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WHATSAPP_ALARMS",
        "class_name": "WhatsappAlarmCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-whatsapp-event-alarm",
      "new_sqlite_classes": [
        "WhatsappAlarmCoordinator"
      ]
    }
  ],
  "triggers": {
    "crons": []
  }
}
