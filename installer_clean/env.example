# Recepción Dr. Armando Revelo — ejemplo de configuración
# Este archivo NO contiene credenciales reales.
# En una reinstalación por cambio de SSD, lo recomendado es importar el .env
# respaldado desde la instalación anterior.

DATABASE_URL=
RP_DATA_DIR=data

AZUR_BASE_URL=
AZUR_API_KEY=
AZUR_TIPO_IVA=0
AZUR_FORMA_PAGO=01
AZUR_LIVE_EMISSION=1

WHATSAPP_CLOUD_MODE=1
WHATSAPP_ENABLED=0
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEST_PHONE=
WHATSAPP_TEMPLATE_CITA_AGENDADA=cita_agendada
WHATSAPP_TEMPLATE_RECORDATORIO_CITA=recordatorio_cita
WHATSAPP_TEMPLATE_RECORDATORIO_HOY=recordatorio_hoy
WHATSAPP_LANGUAGE_CITA_AGENDADA=es_EC
WHATSAPP_LANGUAGE_RECORDATORIO_CITA=es_ES
WHATSAPP_LANGUAGE_RECORDATORIO_HOY=es_EC

AGENDA_CLOUD_BASE_URL=https://fanserick-star.github.io/recepcion-dr-revelo-updates/
REMOTE_AGENDA_AUTOSTART=0
