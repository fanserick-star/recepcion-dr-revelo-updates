{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dr-revelo-enrollment",
  "main": "./enrollment_worker.mjs",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "ENROLLMENTS", "id": "__ENROLLMENTS_KV_NAMESPACE_ID__" }
  ]
}
