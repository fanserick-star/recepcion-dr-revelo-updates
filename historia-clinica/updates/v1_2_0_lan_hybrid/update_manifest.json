{
  "product": "historia-clinica-dr-revelo",
  "version": "1.2.0",
  "app_version": "1.2.0",
  "runtime_version": "1.2.0",
  "mandatory": true,
  "launcher_version": "1.1.10-full-webview-1",
  "updater_version": "historia-release-gate-v11-lan-hybrid",
  "required_dependencies": [
    "app.py",
    "cloud_sync.py",
    "cloud_presence_patch.py",
    "lan_bridge.py",
    "requirements.txt",
    "static/style.css",
    "INICIAR.bat",
    "static/doctor_icon.b64",
    "static/HistoriaClinica_Dr_Revelo.exe.b64"
  ],
  "required_python_packages": [
    {
      "import": "fastapi",
      "pip": "fastapi==0.128.2"
    },
    {
      "import": "uvicorn",
      "pip": "uvicorn==0.48.0"
    },
    {
      "import": "pg8000",
      "pip": "pg8000==1.31.2"
    },
    {
      "import": "webview",
      "pip": "pywebview==6.2.1"
    }
  ],
  "copy": [
    "app.py",
    "cloud_sync.py",
    "cloud_presence_patch.py",
    "lan_bridge.py",
    "requirements.txt",
    "ABRIR_HISTORIA_CLINICA.py",
    "INICIAR.bat",
    "static/style.css",
    "static/doctor_icon.b64",
    "static/HistoriaClinica_Dr_Revelo.exe.b64",
