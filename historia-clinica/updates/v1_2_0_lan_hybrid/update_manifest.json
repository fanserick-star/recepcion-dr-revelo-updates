  "notes": {
    "protected_data": true,
    "protected_env": true,
    "full_webview_required": true,
    "browser_fallback": false,
    "lan_hybrid": true,
    "lan_http_port": 8765,
    "lan_discovery_udp_port": 8766,
    "lan_private_network_only": true,
    "lan_handoff_only_no_clinical_read": true,
    "lan_deduplicate_by_reception_event_id": true,
    "cloud_fallback": true,
