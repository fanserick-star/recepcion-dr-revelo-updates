    "single_source_of_truth": "historia-version.json",
    "legacy_aliases_must_match_source": true,
    "purpose": "Prueba controlada del ciclo de actualización del Launcher v1. No modifica funciones clínicas ni datos."
  },
  "version_source": "historia-version.json",
  "compatibility_version_aliases": true,
  "launcher_minimum": "1.0.4"
