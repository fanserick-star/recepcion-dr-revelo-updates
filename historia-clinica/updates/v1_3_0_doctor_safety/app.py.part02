        if r["phone"]:
            pieces.append(str(r["phone"]))
        if r["birth_date"]:
            pieces.append(human_date(r["birth_date"]))
        result.append({
            "id": r["id"],
            "name": r["name"],
            "detail": " · ".join(pieces) if pieces else "Sin datos de contacto registrados",
            "records": int(r["n_hist"] or 0),
   