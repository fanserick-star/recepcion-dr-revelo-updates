{
  "product": "historia-clinica-dr-revelo",
  "version": "1.3.22",
  "app_version": "1.3.22",
  "runtime_version": "1.3.22",
  "mandatory": true,
  "launcher_version": "historia-launcher-v1.0.7",
  "updater_version": "historia-launcher-v1",
  "version_source": "historia-version.json",
  "compatibility_version_aliases": true,
  "launcher_minimum": "1.0.6",
  "required_dependencies": [
    "app.py",
    "cloud_sync.py",
    "cloud_presence_patch.py",
    "lan_bridge.py",
    "documentos_clinicos.py",
    "requirements.txt",
    "static/style.css",
    "static/doctor_icon.b64"
  ],
  "required_python_packages": [
    {
      "import": "fastapi",
      "pip": "fastapi==0.128.2"
    },
    {
      "import": "uvicorn",
      "pip": "uvicorn==0.48.0"
    },
    {
      "import": "pg8000",
      "pip": "pg8000==1.31.2"
    },
    {
      "import": "webview",
      "pip": "pywebview==6.2.1"
    }
  ],
  "copy": [
    "app.py",
    "cloud_sync.py",
    "documentos_clinicos.py",
    "historia-version.json",
    "update_manifest.json"
  ],
  "notes": {
    "protected_data": true,
    "protected_env": true,
    "full_webview_required": true,
    "browser_fallback": false,
    "transactional_updater": true,
    "sha256_required": true,
    "isolated_preflight": true,
    "rollback": true,
    "single_source_of_truth": "historia-version.json",
    "legacy_aliases_must_match_source": true,
    "database_schema_changes": true,
    "database_schema_change_type": "additive-only-waiting-queue-patient-status",
    "patient_data_destructive_changes": false,
    "signed_history_protected": true,
    "prescriptions": true,
    "certificates": true,
    "configuration_shared_in_cloud": true,
    "printer_configuration_local_only": true,
    "consultation_remains_open_when_issuing_documents": true,
    "internal_document_windows": true,
    "cloud_full_bootstrap": true,
    "cloud_pull_paginated": true,
    "cloud_patients": true,
    "cloud_encounters": true,
    "cloud_prescriptions": true,
    "cloud_certificates": true,
    "cloud_shared_settings": true,
    "neon_source_shared_between_pcs": true,
    "new_patient_confirmation_flow_preserved": true,
    "purpose": "Separar estado Nuevo/Subsecuente del tipo Consulta/Procedimiento para que solo las consultas consuman turno y hacer Receta médica visible desde la ficha del paciente.",
    "functional_changes": true,
    "controlled_launcher_update_test": false,
    "launcher_v1_required": true,
    "cloud_connection_fix": true,
    "env_compatibility_alias": "DATABASE_URL",
    "env_preferred_key": "HISTORIA_DATABASE_URL",
    "previous_version": "1.3.21",
    "cloud_schema": "historia",
    "cloud_schema_isolated_from_reception": true,
    "cloud_self_healing_schema": true,
    "consultation_turns_only": true,
    "procedures_do_not_consume_turn": true,
    "recipe_button_visible_in_consultation": true,
    "recipe_button_position": "consult-tools",
    "certificate_button_visible_in_consultation": true,
    "emergency_local_draft_backup": true,
    "emergency_local_draft_storage": "WebView2 localStorage per patient/queue/encounter",
    "restart_recovery": true,
    "draft_visible_on_patient_page": true,
    "server_autosave_preserved": true,
    "autosave_debounce_ms": 900,
    "autosave_watchdog_ms": 5000,
    "local_snapshot_interval_ms": 1000,
    "cancelled_queue_never_deletes_draft": true,
    "cancelled_queue_action": "detach-only-preserve-draft",
    "cloud_deleted_draft_recovery": true,
    "cloud_recovery_read_only_until_user_restore": true,
    "duplicate_creation_guard": true,
    "duplicate_existing_records_auto_merged": false,
    "queue_link_validation": true,
    "exact_identification_repairs_stale_link": true,
    "ambiguous_same_name_requires_manual_choice": true,
    "candidate_history_count_visible": true,
    "single_new_patient_id": true,
    "reception_historia_shared_patient_uuid": true,
    "new_patient_double_creation_prevented": true,
    "validated_new_patient_link_before_confirmation": true,
    "duplicate_search_prefers_record_with_history": true,
    "existing_duplicate_records_auto_merged": false,
    "waiting_queue_patient_status": true,
    "consultation_only_turn_numbers": true,
    "procedures_show_proc_badge": true,
    "patient_card_recipe_button": true,
    "patient_card_certificate_button": true,
    "global_recipe_nav_visible": true
  }
}
