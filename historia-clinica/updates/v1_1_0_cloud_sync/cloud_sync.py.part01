_SYNC_TABLES = tuple(_TABLE_SPECS)


def _now_iso() -> str:
    return datetime.now().isoformat(timespec="seconds")


def _utc_iso() -> str:
    return datetime.utcnow().replace(microsecond=0).isoformat() + "Z"


def _safe_json_write(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def load_env_file(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for raw in path.read_text(encoding="utf-8-sig", errors="ignore").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def _env_value(root: Path, key: str, default: str = "") -> str:
    value = (os.getenv(key) or "").strip()
    if value:
        return value
    return load_env_file(root / ".env").get(key, default).strip()


def _connect_pg(url: str):
    from pg8000 import dbapi as pg8000

    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in {"postgres", "postgresql"}:
        raise RuntimeError("DATABASE_URL de Historia Clínica no es PostgreSQL")
    user = urllib.parse.unquote(parts.username or "")
    password = urllib.parse.unquote(parts.password or "")
    host = parts.hostname or ""
    database = urllib.parse.unquote((parts.path or "/").lstrip("/")) or "neondb"
    if not (user and password and host):
        raise RuntimeError("DATABASE_URL de Historia Clínica incompleta")
    return pg8000.connect(
        user=user,
        password=password,
        host=host,
        port=int(parts.port or 5432),
        database=database,
        ssl_context=ssl.create_default_context(),
        timeout=12,
    )


def _sqlite(db_path: Path) -> sqlite3.Connection:
    conn = sqlite3.connect(db_path, timeout=20)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys=ON")
    conn.execute("PRAGMA busy_timeout=10000")
    return conn


def ensure_local_sync_schema(db_path: Path) -> None:
    with _sqlite(db_path) as conn:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS sync_control (
              key TEXT PRIMARY KEY,
              value TEXT NOT NULL
            );
            INSERT OR IGNORE INTO sync_control(key,value) VALUES('suppress_outbox','0');

            CREATE TABLE IF NOT EXISTS sync_outbox (
              entity_type TEXT NOT NULL,
              entity_id TEXT NOT NULL,
              operation TEXT NOT NULL DEFAULT 'upsert',
              queued_at TEXT NOT NULL,
              attempts INTEGER NOT NULL DEFAULT 0,
              last_error TEXT,
              PRIMARY KEY(entity_type, entity_id)
            );

            CREATE TABLE IF NOT EXISTS sync_state (
              key TEXT PRIMARY KEY,
              value TEXT NOT NULL
            );

            CREATE INDEX IF NOT EXISTS idx_sync_outbox_queued ON sync_outbox(queued_at);
            """
        )
        for table, spec in _TABLE_SPECS.items():
            pk = spec["pk"]
            for suffix, timing, ref, op in (
                ("ai", "AFTER INSERT", "NEW", "upsert"),
                ("au", "AFTER UPDATE", "NEW", "upsert"),
                ("ad", "AFTER DELETE", "OLD", "delete"),
            ):
                conn.execute(f"DROP TRIGGER IF EXISTS sync_{table}_{suffix}")
                conn.execute(
                    f"""
                    CREATE TRIGGER sync_{table}_{suffix} {timing} ON {table}
                    WHEN COALESCE((SELECT value FROM sync_control WHERE key='suppress_outbox'),'0')!='1'
                    BEGIN
                      INSERT INTO sync_outbox(entity_type,entity_id,operation,queued_at,attempts,last_error)
                      VALUES('{table}', CAST({ref}.{pk} AS TEXT), '{op}', datetime('now','localtime'), 0, NULL)
                      ON CONFLICT(entity_type,entity_id) DO UPDATE SET
                        operation=excluded.operation, queued_at=excluded.queued_at, attempts=0, last_error=NULL;
                    END
                    """
                )

        # Audit log uses its integer local id; the cloud key is namespaced by device_id.
        for suffix, timing, ref in (("ai", "AFTER INSERT", "NEW"), ("au", "AFTER UPDATE", "NEW")):
            conn.execute(f"DROP TRIGGER IF EXISTS sync_audit_log_{suffix}")
            conn.execute(
                f"""
                CREATE TRIGGER sync_audit_log_{suffix} {timing} ON audit_log
                WHEN COALESCE((SELECT value FROM sync_control WHERE key='suppress_outbox'),'0')!='1'
                BEGIN
                  INSERT INTO sync_outbox(entity_type,entity_id,operation,queued_at,attempts,last_error)
                  VALUES('audit_log', CAST({ref}.id AS TEXT), 'upsert', datetime('now','localtime'), 0, NULL)
                  ON CONFLICT(entity_type,entity_id) DO UPDATE SET
                    operation='upsert', queued_at=excluded.queued_at, attempts=0, last_error=NULL;
                END
                """
            )

        for suffix, timing, ref in (("ai", "AFTER INSERT", "NEW"), ("au", "AFTER UPDATE", "NEW")):
            conn.execute(f"DROP TRIGGER IF EXISTS sync_encounter_revisions_{suffix}")
            conn.execute(
                f"""
                CREATE TRIGGER sync_encounter_revisions_{suffix} {timing} ON encounter_revisions
                WHEN COALESCE((SELECT value FROM sync_control WHERE key='suppress_outbox'),'0')!='1'
                BEGIN
                  INSERT INTO sync_outbox(entity_type,entity_id,operation,queued_at,attempts,last_error)
                  VALUES('encounter_revisions', CAST({ref}.id AS TEXT), 'upsert', datetime('now','localtime'), 0, NULL)
                  ON CONFLICT(entity_type,entity_id) DO UPDATE SET
                    operation='upsert', queued_at=excluded.queued_at, attempts=0, last_error=NULL;
                END
                """
            )
        conn.commit()


def _state_get(conn: sqlite3.Connection, key: str, default: str = "") -> str:
    row = conn.execute("SELECT value FROM sync_state WHERE key=?", (key,)).fetchone()
    return str(row[0]) if row else default


def _state_set(conn: sqlite3.Connection, key: str, value: Any) -> None:
    conn.execute(
        "INSERT INTO sync_state(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
        (key, str(value)),
    )


def get_device_id(db_path: Path) -> str:
    with _sqlite(db_path) as conn:
        device_id = _state_get(conn, "device_id")
        if not device_id:
            device_id = str(uuid.uuid4())
            _state_set(conn, "device_id", device_id)
            conn.commit()
        return device_id


def get_sync_status(data_dir: Path) -> dict[str, Any]:
    path = data_dir / "sync_status.json"
    if not path.is_file():
        return {
            "enabled": False,
            "online": False,
            "state": "local_only",
            "message": "Nube pendiente de configurar",
            "pending": 0,
            "last_success": "",
            "last_error": "",
            "bootstrap_complete": False,
        }
    try:
        data = json.loads(path.read_text(encoding="utf-8-sig"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {"enabled": False, "online": False, "state": "error", "message": "Estado de nube no disponible"}


def create_rotating_backup(db_path: Path, data_dir: Path, keep: int = 14) -> Path | None:
    if not db_path.is_file():
        return None
    backup_dir = data_dir / "backups"
    backup_dir.mkdir(parents=True, exist_ok=True)
    today = datetime.now().strftime("%Y-%m-%d")
    target = backup_dir / f"historia_clinica_{today}.db"
    if not target.exists():
        src = sqlite3.connect(db_path)
        dst = sqlite3.connect(target)
        try:
            src.backup(dst)
        finally:
            dst.close(); src.close()
    old = sorted(backup_dir.glob("historia_clinica_*.db"), key=lambda p: p.stat().st_mtime, reverse=True)
    for p in old[max(1, int(keep)):]:
        try:
            p.unlink()
        except Exception:
            pass
    return target


def _normalize_search(value: Any) -> str:
    import unicodedata, re
    text = unicodedata.normalize("NFKD", str(value or "")).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^A-Za-z0-9]+", " ", text.upper()).strip()
    return " ".join(text.split())


def _upsert_cloud(cursor, table: str, values: dict[str, Any]) -> None:
    spec = _TABLE_SPECS[table]
    cols = spec["columns"]
    pk = spec["pk"]
    actual = {c: values.get(c) for c in cols}
    placeholders = ",".join(["%s"] * len(cols))
    assignments = ",".join(f"{c}=EXCLUDED.{c}" for c in cols if c != pk)
    sql = f"INSERT INTO {table} ({','.join(cols)}) VALUES ({placeholders}) ON CONFLICT ({pk}) DO UPDATE SET {assignments}"
    cursor.execute(sql, tuple(actual[c] for c in cols))


def _delete_cloud(cursor, table: str, entity_id: str) -> None:
    spec = _TABLE_SPECS[table]
    cursor.execute(f"DELETE FROM {table} WHERE {spec['pk']}=%s", (entity_id,))


def _load_local_entity(conn: sqlite3.Connection, table: str, entity_id: str) -> dict[str, Any] | None:
    if table in _TABLE_SPECS:
        pk = _TABLE_SPECS[table]["pk"]
        row = conn.execute(f"SELECT * FROM {table} WHERE {pk}=?", (entity_id,)).fetchone()
        return dict(row) if row else None
    if table == "audit_log":
        row = conn.execute("SELECT * FROM audit_log WHERE id=?", (entity_id,)).fetchone()
        return dict(row) if row else None
    if table == "encounter_revisions":
        row = conn.execute("SELECT * FROM encounter_revisions WHERE id=?", (entity_id,)).fetchone()
        return dict(row) if row else None
    return None


def _push_special(cursor, table: str, row: dict[str, Any], device_id: str) -> None:
    if table == "audit_log":
        cloud_id = f"{device_id}:{row['id']}"
        cursor.execute(
            """INSERT INTO audit_log(id,occurred_at,actor,action,entity_type,entity_id,details_json,device_id)
               VALUES(%s,%s,%s,%s,%s,%s,%s,%s)
               ON CONFLICT(id) DO UPDATE SET occurred_at=EXCLUDED.occurred_at,actor=EXCLUDED.actor,
                 action=EXCLUDED.action,entity_type=EXCLUDED.entity_type,entity_id=EXCLUDED.entity_id,
                 details_json=EXCLUDED.details_json,device_id=EXCLUDED.device_id""",
            (cloud_id, row.get("occurred_at"), row.get("actor"), row.get("action"), row.get("entity_type"),
             row.get("entity_id"), row.get("details_json"), device_id),
        )
        return
    if table == "encounter_revisions":
        source_key = f"{device_id}:{row['id']}"
        cursor.execute(
            """INSERT INTO encounter_revisions(source_key,encounter_id,revision_no,saved_at,actor,clinical_note,diagnosis,treatment,reason)
               VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s)
               ON CONFLICT(source_key) DO UPDATE SET encounter_id=EXCLUDED.encounter_id,revision_no=EXCLUDED.revision_no,
                 saved_at=EXCLUDED.saved_at,actor=EXCLUDED.actor,clinical_note=EXCLUDED.clinical_note,
                 diagnosis=EXCLUDED.diagnosis,treatment=EXCLUDED.treatment,reason=EXCLUDED.reason""",
            (source_key, row.get("encounter_id"), row.get("revision_no"), row.get("saved_at"), row.get("actor"),
             row.get("clinical_note"), row.get("diagnosis"), row.get("treatment"), row.get("reason")),
        )
        return
    raise RuntimeError(f"Entidad especial no soportada: {table}")


def _bootstrap_table(sqlite_conn: sqlite3.Connection, pg_cursor, table: str, device_id: str, progress_cb) -> int:
    total = sqlite_conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]
    done = 0
    if table in _TABLE_SPECS:
        rows = sqlite_conn.execute(f"SELECT * FROM {table}").fetchall()
        for row in rows:
            _upsert_cloud(pg_cursor, table, dict(row))
            done += 1
            if done % 100 == 0:
                progress_cb(table, done, total)
    elif table == "audit_log":
        rows = sqlite_conn.execute("SELECT * FROM audit_log").fetchall()
        for row in rows:
            _push_special(pg_cursor, table, dict(row), device_id)
            done += 1
            if done % 100 == 0: progress_cb(table, done, total)
    elif table == "encounter_revisions":
        rows = sqlite_conn.execute("SELECT * FROM encounter_revisions").fetchall()
        for row in rows:
            _push_special(pg_cursor, table, dict(row), device_id)
            done += 1
            if done % 100 == 0: progress_cb(table, done, total)
    progress_cb(table, done, total)
    return done


def _parse_cloud_ts(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, datetime):
        return value.isoformat()
    return str(value)


def _apply_cloud_rows(db_path: Path, table: str, columns: list[str], rows: list[tuple[Any, ...]]) -> int:
    if not rows:
        return 0
    spec = _TABLE_SPECS[table]
    local_cols = spec["columns"]
    pk = spec["pk"]
    positions = {name: idx for idx, name in enumerate(columns)}
    with _sqlite(db_path) as conn:
        conn.execute("UPDATE sync_control SET value='1' WHERE key='suppress_outbox'")
        try:
            for raw in rows:
                row = {c: raw[positions[c]] if c in positions else None for c in local_cols}
                # Waiting queue can arrive without a clinical link. Resolve safely.
                if table == "waiting_queue" and not row.get("clinical_patient_id"):
                    reception_id = str(row.get("reception_patient_id") or "")
                    if reception_id:
                        link = conn.execute("SELECT clinical_patient_id FROM patient_links WHERE reception_patient_id=?", (reception_id,)).fetchone()
                        if link:
                            row["clinical_patient_id"] = link[0]
                    if not row.get("clinical_patient_id") and row.get("identification"):
                        key = _normalize_search(row.get("identification"))
                        matches = conn.execute("SELECT id FROM patients WHERE national_id_search=? LIMIT 2", (key,)).fetchall()
                        if len(matches) == 1:
                            patient_id = matches[0][0]
                            row["clinical_patient_id"] = patient_id
                            stamp = _now_iso()
                            conn.execute(
                                """INSERT INTO patient_links(reception_patient_id,clinical_patient_id,matched_by,verified,verified_at,created_at,updated_at)
                                   VALUES(?,?,?,?,?,?,?) ON CONFLICT(reception_patient_id) DO UPDATE SET
                                   clinical_patient_id=excluded.clinical_patient_id,matched_by=excluded.matched_by,
                                   verified=excluded.verified,verified_at=excluded.verified_at,updated_at=excluded.updated_at""",
                                (reception_id, patient_id, "national_id", 1, stamp, stamp, stamp),
                            )
                vals = [row.get(c) for c in local_cols]
                placeholders = ",".join("?" for _ in local_cols)
                assignments = ",".join(f"{c}=excluded.{c}" for c in local_cols if c != pk)
                conn.execute(
                    f"INSERT INTO {table} ({','.join(local_cols)}) VALUES ({placeholders}) ON CONFLICT({pk}) DO UPDATE SET {assignments}",
                    vals,
                )
        finally:
            conn.execute("UPDATE sync_control SET value='0' WHERE key='suppress_outbox'")
            # Newly auto-created links should be sent back to the cloud for future queue items.
            if table == "waiting_queue":
                links = conn.execute(
                    """SELECT reception_patient_id FROM patient_links
                       WHERE matched_by='national_id' AND reception_patient_id NOT IN
                       (SELECT entity_id FROM sync_outbox WHERE entity_type='patient_links')"""
                ).fetchall()
                stamp = _now_iso()
                for link in links:
                    conn.execute(
                        """INSERT INTO sync_outbox(entity_type,entity_id,operation,queued_at,attempts,last_error)
                           VALUES('patient_links',?,'upsert',?,0,NULL)
                           ON CONFLICT(entity_type,entity_id) DO UPDATE SET operation='upsert',queued_at=excluded.queued_at,attempts=0,last_error=NULL""",
                        (str(link[0]), stamp),
                    )
            conn.commit()
    return len(rows)


class CloudSyncService:
    def __init__(self, root: Path, db_path: Path):
        self.root = Path(root)
        self.db_path = Path(db_path)
        self.data_dir = self.db_path.parent
        self.status_path = self.data_dir / "sync_status.json"
        self._stop = threading.Event()
        self._wake = threading.Event()
        self._thread: threading.Thread | None = None
        self._last_activity = time.monotonic()
        self._lock = threading.Lock()
        self._running_cycle = False
        self.device_id = get_device_id(self.db_path)
        self.database_url = _env_value(self.root, "HISTORIA_DATABASE_URL") or _env_value(self.root, "DATABASE_URL")
        self.enabled = bool(self.database_url)
        self._write_status(
            enabled=self.enabled,
            online=False,
            state="ready" if self.enabled else "local_only",
            message="Nube lista para sincronizar" if self.enabled else "Nube pendiente de configurar",
        )

    d