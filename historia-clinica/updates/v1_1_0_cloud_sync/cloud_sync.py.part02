ef _write_status(self, **patch: Any) -> None:
        with self._lock:
            current = get_sync_status(self.data_dir)
            current.update(patch)
            current["device_id"] = self.device_id
            current["app_version"] = APP_VERSION
            try:
                with _sqlite(self.db_path) as conn:
                    current["pending"] = int(conn.execute("SELECT COUNT(*) FROM sync_outbox").fetchone()[0])
                    current["bootstrap_complete"] = _state_get(conn, "cloud_bootstrap_complete", "0") == "1"
            except Exception:
                current.setdefault("pending", 0)
            _safe_json_write(self.status_path, current)

    def mark_activity(self) -> None:
        self._last_activity = time.monotonic()
        if self.enabled:
            self._wake.set()

    def wake(self) -> None:
        if self.enabled:
            self._wake.set()

    def start(self) -> None:
        if self._thread and self._thread.is_alive():
            return
        ensure_local_sync_schema(self.db_path)
        try:
            create_rotating_backup(self.db_path, self.data_dir)
        except Exception:
            pass
        self._stop.clear()
        self._thread = threading.Thread(target=self._loop, name="HistoriaCloudSync", daemon=True)
        self._thread.start()

    def stop(self) -> None:
        self._stop.set(); self._wake.set()
        if self._thread and self._thread.is_alive():
            self._thread.join(timeout=3)

    def _loop(self) -> None:
        if not self.enabled:
            return
        time.sleep(1.5)
        while not self._stop.is_set():
            try:
                self.sync_once()
                active = (time.monotonic() - self._last_activity) < 300
                timeout = 20 if active else 300
            except Exception as exc:
                self._write_status(
                    online=False,
                    state="offline",
                    message="Trabajando localmente; la nube se reintentará",
                    last_error=f"{type(exc).__name__}: {str(exc)[:300]}",
                    last_error_at=_utc_iso(),
                )
                timeout = 60
            self._wake.wait(timeout=timeout)
            self._wake.clear()

    def _progress(self, table: str, done: int, total: int) -> None:
        self._write_status(
            online=True,
            state="bootstrap",
            message=f"Respaldo inicial en nube: {table} {done}/{total}",
            bootstrap_table=table,
            bootstrap_done=done,
            bootstrap_total=total,
        )

    def _register_device(self, cur) -> None:
        display = os.getenv("COMPUTERNAME") or "PC Historia Clínica"
        now = _now_iso()
        cur.execute(
            """INSERT INTO devices(id,display_name,first_seen_at,last_seen_at,app_version)
               VALUES(%s,%s,%s,%s,%s)
               ON CONFLICT(id) DO UPDATE SET display_name=EXCLUDED.display_name,last_seen_at=EXCLUDED.last_seen_at,
                 app_version=EXCLUDED.app_version""",
            (self.device_id, display, now, now, APP_VERSION),
        )

    def _bootstrap_if_needed(self, pg, cur) -> None:
        with _sqlite(self.db_path) as local:
            if _state_get(local, "cloud_bootstrap_complete", "0") == "1":
                return
            cur.execute("SELECT COUNT(*) FROM patients")
            cloud_patients = int(cur.fetchone()[0])
            local_patients = int(local.execute("SELECT COUNT(*) FROM patients").fetchone()[0])
            if cloud_patients > 0:
                # Existing cloud data: do not blindly duplicate. Pull will reconcile.
                _state_set(local, "cloud_bootstrap_complete", "1")
                _state_set(local, "cloud_bootstrap_note", f"cloud_preexisting:{cloud_patients}")
                local.commit()
                return
            self._write_status(online=True, state="bootstrap", message="Iniciando respaldo completo en Neon")
            for table in ("patients", "encounters", "patient_links", "waiting_queue", "encounter_addenda", "macros", "encounter_revisions", "audit_log"):
                _bootstrap_table(local, cur, table, self.device_id, self._progress)
                pg.commit()
            # Existing rows are now represented remotely; clear insert/update backlog generated before bootstrap.
            local.execute("DELETE FROM sync_outbox")
            _state_set(local, "cloud_bootstrap_complete", "1")
            _state_set(local, "cloud_bootstrap_patients", local_patients)
            _state_set(local, "cloud_last_pull", datetime.utcnow().replace(microsecond=0).isoformat() + "+00:00")
            local.commit()
            self._write_status(online=True, state="syncing", message="Respaldo inicial completado")

    def _push_outbox(self, pg, cur, max_items: int = 250) -> int:
        pushed = 0
        with _sqlite(self.db_path) as local:
            items = local.execute(
                "SELECT entity_type,entity_id,operation FROM sync_outbox ORDER BY queued_at LIMIT ?",
                (max_items,),
            ).fetchall()
            for item in items:
                table, entity_id, operation = item["entity_type"], item["entity_id"], item["operation"]
                try:
                    if table in _TABLE_SPECS:
                        if operation == "delete":
                            _delete_cloud(cur, table, entity_id)
                        else:
                            row = _load_local_entity(local, table, entity_id)
                            if row is None:
                                _delete_cloud(cur, table, entity_id)
                            else:
                                _upsert_cloud(cur, table, row)
                    elif table in {"audit_log", "encounter_revisions"}:
                        row = _load_local_entity(local, table, entity_id)
                        if row is not None:
                            _push_special(cur, table, row, self.device_id)
                    pg.commit()
                    local.execute("DELETE FROM sync_outbox WHERE entity_type=? AND entity_id=?", (table, entity_id))
                    local.commit()
                    pushed += 1
                except Exception as exc:
                    pg.rollback()
                    local.execute(
                        "UPDATE sync_outbox SET attempts=attempts+1,last_error=? WHERE entity_type=? AND entity_id=?",
                        (f"{type(exc).__name__}: {str(exc)[:240]}", table, entity_id),
                    )
                    local.commit()
                    raise
        return pushed

    def _pull_cloud(self, pg, cur) -> int:
        with _sqlite(self.db_path) as local:
            marker = _state_get(local, "cloud_last_pull", "1970-01-01T00:00:00+00:00")
        total = 0
        newest = marker
        # Small overlap prevents a same-millisecond boundary from being missed.
        try:
            base_dt = datetime.fromisoformat(marker.replace("Z", "+00:00")) - timedelta(seconds=2)
            since = base_dt.isoformat()
        except Exception:
            since = "1970-01-01T00:00:00+00:00"
        for table, spec in _TABLE_SPECS.items():
            cols = spec["columns"] + ["cloud_updated_at"]
            cur.execute(
                f"SELECT {','.join(cols)} FROM {table} WHERE cloud_updated_at > %s ORDER BY cloud_updated_at ASC LIMIT 5000",
                (since,),
            )
            rows = cur.fetchall()
            if rows:
                total += _apply_cloud_rows(self.db_path, table, cols, rows)
                for raw in rows:
                    ts = _parse_cloud_ts(raw[-1])
                    if ts and ts > newest:
                        newest = ts
        # Cloud completion may arrive from Reception or another device; queue is enough for the current workflow.
        with _sqlite(self.db_path) as local:
            _state_set(local, "cloud_last_pull", newest if newest != marker else datetime.utcnow().replace(microsecond=0).isoformat() + "+00:00")
            local.commit()
        return total

    def sync_once(self) -> dict[str, Any]:
        if not self.enabled:
            return {"enabled": False}
        if self._running_cycle:
            return {"enabled": True, "busy": True}
        self._running_cycle = True
        pg = None
        cur = None
        try:
            self._write_status(state="connecting", message="Conectando con Neon…")
            pg = _connect_pg(self.database_url)
            cur = pg.cursor()
            self._register_device(cur); pg.commit()
            self._bootstrap_if_needed(pg, cur)
            pushed = self._push_outbox(pg, cur)
            pulled = self._pull_cloud(pg, cur)
            self._write_status(
                enabled=True,
                online=True,
                state="synced",
                message="Nube sincronizada",
                last_success=_utc_iso(),
                last_error="",
                pushed=pushed,
                pulled=pulled,
            )
            return {"enabled": True, "online": True, "pushed": pushed, "pulled": pulled}
        finally:
            self._running_cycle = False
            try:
                if cur is not None: cur.close()
            except Exception:
                pass
            try:
                if pg is not None: pg.close()
            except Exception:
                pass


_service: CloudSyncService | None = None


def build_sync_service(root: Path, db_path: Path) -> CloudSyncService:
    global _service
    if _service is None:
        _service = CloudSyncService(root, db_path)
    return _service


def get_sync_service() -> CloudSyncService | None:
    return _service