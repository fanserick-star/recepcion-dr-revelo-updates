{
  "product": "historia-clinica-dr-revelo",
  "version": "1.1.8",
  "app_version": "1.1.8",
  "runtime_version": "1.1.8",
  "mandatory": true,
  "launcher_version": "1.1.6-native-branding-1",
  "updater_version": "historia-release-gate-v6-idle-presence",
  "required_dependencies": [
    "app.py",
    "cloud_sync.py",
    "cloud_presence_patch.py",
    "requirements.txt",
    "static/style.css",
    "INICIAR.bat",
    "static/doctor_icon.b64",
    "static/HistoriaClinica_Dr_Revelo.exe.b64"
  ],
  "required_python_packages": [
    {"import": "fastapi", "pip": "fastapi==0.128.2"},
    {"import": "uvicorn", "pip": "uvicorn==0.48.0"},
    {"import": "pg8000", "pip": "pg8000>=1.31,<2"},
    {"import": "webview", "pip": "pywebview>=5.4,<7"}
  ],
  "copy": [
    "app.py",
    "cloud_sync.py",
    "cloud_presence_patch.py",
    "update_manifest.json"
  ],
  "notes": {
    "protected_data": true,
    "protected_env": true,
    "download_only_changed_files": true,
    "sha256_validation": true,
    "python_syntax_preflight": true,
    "isolated_trial_boot": true,
    "automatic_rollback_after_startup_failure": true,
    "required_dependency_guard": true,
    "cloud_sync_progress_live": true,
    "initial_total_forced": true,
    "skipped_intermediate_release_safe": true,
    "doctor_presence_heartbeat_seconds": 240,
    "doctor_online_threshold_seconds": 300,
    "idle_presence_heartbeat": true,
    "device_reports_actual_app_version": true,
    "queue_live_refresh": true,
    "automatic_updates_only": true,
    "shortcut_self_heal": true,
    "native_launcher": true,
    "native_launcher_filename": "HistoriaClinica_Dr_Revelo.exe",
    "sync_now_button": true,
    "open_program_folder_button": true,
    "database_schema_changes": false
  }
