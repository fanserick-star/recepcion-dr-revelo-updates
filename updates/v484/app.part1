WHATSAPP_APPROVED_CITA_AGENDADA = (os.getenv("WHATSAPP_APPROVED_CITA_AGENDADA") or "1").strip() != "0"
WHATSAPP_APPROVED_RECORDATORIO_CITA = (os.getenv("WHATSAPP_APPROVED_RECORDATORIO_CITA") or "1").strip() != "0"
